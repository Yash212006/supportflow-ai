# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Local (non-Docker) database and cache. docker-compose overrides these.
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow
REDIS_URL=redis://localhost:6379/0
# Local (non-Docker) frontend. Docker ignores these and uses http://localhost:8080
# (override with DOCKER_FRONTEND_URL=..., e.g. a public tunnel URL). PayPal sends the buyer back to this URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Public URL PayPal redirects back to / webhooks reach (use a tunnel such as ngrok for webhooks in dev).
PUBLIC_API_URL=http://localhost:8000

# --- PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
# Leave blank to run in sample-data mode: no payment or refund will ever be shown as successful.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's webhook settings. Without it, webhooks are rejected (not trusted).
PAYPAL_WEBHOOK_ID=

# --- LLM provider: openai | gemini | none (none = deterministic mode, no AI text generation) ---
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Set true only if your key is a Vertex AI (express mode) key rather than a Gemini Developer API key.
GEMINI_USE_VERTEXAI=false
# Gemini Developer API version; v1beta serves all current models and the gemini-flash-latest alias.
GEMINI_API_VERSION=v1beta
# Used automatically if the main model errors or times out.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Seconds per model call.
LLM_TIMEOUT_SECONDS=60

# --- AG Studio licence (browser-visible by design; without it AG Studio shows an evaluation watermark) ---
VITE_AG_LICENSE_KEY=

# Business currency for seeded data. PayPal Sandbox accounts often cannot settle INR; use USD to demo live captures/refunds.
DEMO_CURRENCY=INR

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
